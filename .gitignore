.env
.env.*
!.env.example
# Local development services and data created by 启动项目.bat (PostgreSQL
# cluster, portable Redis, logs and the compiled backend binary).
.dev/
.idea/
.vscode/
node_modules/
dist/
coverage/
*.log
*.exe
backend/bin/
# Attachment storage. The service may resolve MEDIA_DIR to the repository root
# or to backend/ depending on where it is started, so both are ignored.
media/
/media/
backend/media/
.media-test-*/
postgres.log
.DS_Store
Thumbs.db
credentials.json

# Scratch file used to pass multi-line commit messages on Windows.
.git-commit-msg.txt
