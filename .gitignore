.env
.env.*
!.env.example
# Local development services and data created by 启动项目.bat (PostgreSQL
# cluster, portable Redis, logs and the compiled backend binary).
.dev/
.idea/
.vscode/
node_modules/
dist/
!desktop/frontend/dist/
desktop/frontend/dist/*
!desktop/frontend/dist/.gitkeep
desktop/frontend/wailsjs/
# Migration SQL files are copied from database/migrations by
# scripts/build-desktop.ps1 before the launcher is built; only the placeholder
# that lets `go build` compile the embedded filesystem is committed.
desktop/migrations/*
!desktop/migrations/.keep
desktop/build/bin/
desktop/build/
desktop/build/windows/*.syso
desktop/*.syso
coverage/
# Wails frontend install marker produced by desktop builds.
web/package.json.md5
*.log
*.exe
backend/bin/
# Attachment storage. The service may resolve MEDIA_DIR to the repository root
# or to backend/ depending on where it is started, so both are ignored.
media/
/media/
backend/media/
.media-test-*/
postgres.log
.DS_Store
Thumbs.db
credentials.json

# Scratch file used to pass multi-line commit messages on Windows.
.git-commit-msg.txt
